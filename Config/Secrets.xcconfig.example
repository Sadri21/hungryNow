// Secrets.xcconfig.example
// HungryNow — Google Places iOS SDK configuration
//
// 1. Copy this file to `Secrets.xcconfig`:
//    cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
// 2. Replace the placeholder below with your dedicated iOS Places API key.
//    Ensure the key is restricted in Google Cloud Console to:
//    - Application restriction: iOS apps (bundle ID: com.revaiter.hungrynow)
//    - API restriction: Places SDK for iOS / Places API (New)
//
// Config/Secrets.xcconfig is ignored by .gitignore to keep your key out of version control.

PLACES_API_KEY = YOUR_GOOGLE_PLACES_API_KEY
